<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectGuid>{B7A5CAFE-1111-2222-3333-444455556688}</ProjectGuid>
    <!-- Portable browser/WASM host adapter: no framework-specific dependency, so it
         targets netstandard2.0 like the core and is consumable by a net8/net10 WASM app. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>MVCGrid.Wasm</AssemblyName>
    <RootNamespace>MVCGrid.Wasm</RootNamespace>
    <LangVersion>latest</LangVersion>

    <!-- NuGet: browser/WebAssembly host adapter. Depends on MVCGrid (core) via
         ProjectReference (emitted by pack); no other dependencies. -->
    <PackageId>MVCGrid.Wasm</PackageId>
    <Title>MVCGrid.Net for the browser (WebAssembly)</Title>
    <Description>Browser/WebAssembly host adapter for MVCGrid.Net. Runs the portable MVCGrid core entirely client-side (no server): WasmGridRenderer produces the grid HTML, answers the client script's AJAX requests and exports in-process, and serves the unchanged MVCGrid.js. Powers the MVCGrid.Net live demo site.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MVCGrid.Core\MVCGrid.Core.csproj" />
  </ItemGroup>

</Project>
