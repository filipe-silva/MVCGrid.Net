<Project>

  <!-- SHARED BLOCK - keep it exactly as it is, byte for byte. Put this repo's own settings below the separator, in this same file. -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Binding redirects for projects that carry an app.config or a web.config.
       GenerateBindingRedirectsOutputType extends the generation to library and test outputs, which are skipped otherwise. -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/app.config') Or Exists('$(MSBuildProjectDirectory)/web.config')">
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <!-- ================================ end of shared block ================================ -->

  <!-- Shared NuGet package metadata for the four shippable libraries
       (MVCGrid, MVCGrid.MvcWeb, MVCGrid.AspNetCore, MVCGrid.Wasm). Per-package
       PackageId, Title, Description and the README pack-include live in each .csproj.
       Sample apps under tst/ opt out with <IsPackable>false</IsPackable>. -->
  <PropertyGroup>
    <Version>3.0.0</Version>
    <Authors>filipe-silva</Authors>
    <Company>filipe-silva</Company>
    <Copyright>Copyright (c) 2015 bigjoe714 (original), (c) 2026 filipe-silva (fork)</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/filipe-silva/MVCGrid.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/filipe-silva/MVCGrid.Net.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>mvc grid ajax bootstrap paging sorting filtering csv aspnetcore</PackageTags>
    <PackageReleaseNotes>3.0.0 — Library split into a portable netstandard2.0 core (MVCGrid) plus thin host adapters: MVCGrid.MvcWeb (classic ASP.NET MVC 3/4/5), MVCGrid.AspNetCore (ASP.NET Core, RenderingEngine mode) and MVCGrid.Wasm (browser/WebAssembly, no server).</PackageReleaseNotes>
    <!-- Ship a symbol package (.snupkg) and embed source-link-friendly metadata. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

</Project>
