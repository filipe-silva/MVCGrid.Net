<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Shared demo domain + portable grid catalog for all three example hosts.
         netstandard2.0 so the net48, net8 and net10-wasm examples can all reference it. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>MVCGrid.Example.Common</AssemblyName>
    <RootNamespace>MVCGrid.Example.Common</RootNamespace>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MVCGrid.Core\MVCGrid.Core.csproj" />
  </ItemGroup>

  <!-- Embed the grid catalog source so CodeSnippets can show each grid's config code,
       the API-reference data that feeds the Documentation page's doc grids, and the
       shared site page bodies (StaticPages loads Pages/*.html on first use). -->
  <ItemGroup>
    <EmbeddedResource Include="SampleGrids.cs">
      <LogicalName>SampleGrids.cs.txt</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="documentation.csv" />
    <EmbeddedResource Include="Pages\*.html" />
  </ItemGroup>

</Project>
