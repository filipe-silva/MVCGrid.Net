@{
    ViewBag.Title = "Home Page";
    var hostNote = "<p class=\"text-muted\">This host runs the same portable grid engine on <strong>ASP.NET Core</strong> via <code>MVCGrid.AspNetCore</code>, with the grids defined once in the shared <code>MVCGrid.Example.Common</code> library.</p>";
}

@* Page body is defined once in the shared example library (StaticPages) and rendered by all hosts. *@
@Html.Raw(StaticPages.HomeHtml(hostNote, name => Html.MVCGrid(name).ToString()))
